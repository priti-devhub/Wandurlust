<% layout("/layouts/boilerplate")%>
    <div class="row mt-3">
        <h1 class="col-6 offset-3">Login to Wanderlust</h1>
        <div class="col-6 offset-3">
            <form action="/login" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="Username" class="form-label">Username</label>
                    <input name="username" placeholder="Enter username" class="form-control" required>
                    <div class="valid-feedback">
                        Username looks good! </div>
                </div>
                
                <div class="mb-3">
                    <label for="Password" class="form-label">Password</label>
                    <input name="password" type="password" placeholder="Enter password" class="form-control" required>
                    <div class="valid-feedback">
                        Password looks good! </div>
                </div>
                <button type="submit" class="btn btn-success">Login</button>
            </form>
         </div>
     </div>